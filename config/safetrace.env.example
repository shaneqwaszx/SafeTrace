KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
SAFETRACE_APP_ROOT=.
SAFETRACE_DEVICE=cpu
SAFETRACE_ENABLE_GPU_AUTO=true
SAFETRACE_LIGHTWEIGHT_VLM_DEVICE=auto
SAFETRACE_ENHANCED_VLM_DEVICE=cuda
SAFETRACE_MOBILESAM_DEVICE=auto
SAFETRACE_SIGLIP_DIR=checkpoints/siglip-base-patch16-224
SAFETRACE_YOLO_CKPT=checkpoints/yolov9c-seg.pt
SAFETRACE_YOLO_FALLBACK_CKPT=checkpoints/yolov8s-seg.pt
SAFETRACE_CHAT_ENABLED=auto
SAFETRACE_CHAT_PROVIDER=packaged_llamacpp
SAFETRACE_CHAT_SPEED_PROFILE=fast
SAFETRACE_CHAT_MODEL_PATH=models/chat/safetrace-assistant-qwen2.5-1.5b-instruct-q4.gguf
SAFETRACE_SERVE_FRONTEND=true
SAFETRACE_FRONTEND_DIST=frontend/dist
SAFETRACE_BUILD_MODE=release-package
SAFETRACE_RUNTIME_LAYOUT=packaged
SAFETRACE_ANALYSIS_SAFE_MODE=true
SAFETRACE_SAFE_MODE_ALLOW_MOBILESAM=false
SAFETRACE_ANALYSIS_JOB_TIMEOUT_SECONDS=600
SAFETRACE_MOBILESAM_ENABLED=false
SAFETRACE_MOBILESAM_CHECKPOINT=checkpoints/mobile_sam.pt
SAFETRACE_MOBILESAM_TIMEOUT_SECONDS=20
SAFETRACE_MOBILESAM_WORKER_ENABLED=false
SAFETRACE_MOBILESAM_WORKER_TIMEOUT_SECONDS=60
SAFETRACE_VLM_ENABLED=false
SAFETRACE_VLM_PROVIDER=auto
SAFETRACE_VLM_MODEL_PATH=models/vlm
SAFETRACE_VLM_DIR=models/vlm
SAFETRACE_VLM_PROFILE=rule_based
SAFETRACE_VLM_LIGHTWEIGHT_MODEL_PATH=models/vlm/lightweight-256m
SAFETRACE_VLM_LIGHTWEIGHT_512M_MODEL_PATH=models/vlm/lightweight-512m
SAFETRACE_VLM_ENHANCED_MODEL_PATH=models/vlm/enhanced-2b
SAFETRACE_VLM_ENHANCED_3B_MODEL_PATH=models/vlm/enhanced-3b
SAFETRACE_VLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
SAFETRACE_VLM_MODEL=local-vlm
SAFETRACE_VLM_TIMEOUT_SECONDS=10
SAFETRACE_VLM_MAX_FRAMES=5
SAFETRACE_VLM_FRAME_LIMIT=5
SAFETRACE_VLM_MAX_EVIDENCE_FRAMES=5
SAFETRACE_VLM_JOB_TIMEOUT_SECONDS=0
SAFETRACE_VLM_MAX_QUALITY_FAILURES=1
SAFETRACE_VLM_DISABLE_AFTER_TIMEOUT=true
SAFETRACE_VLM_MAX_TOKENS=40
SAFETRACE_LIGHTWEIGHT_VLM_PRIMARY=auto
SAFETRACE_LIGHTWEIGHT_VLM_FALLBACK=256m
SAFETRACE_LIGHTWEIGHT_VLM_CPU_PREFER_256M=true
SAFETRACE_LIGHTWEIGHT_VLM_TIMEOUT_SECONDS=90
SAFETRACE_LIGHTWEIGHT_VLM_TOTAL_BUDGET_SECONDS=0
SAFETRACE_LIGHTWEIGHT_VLM_WORKER_ENABLED=false
SAFETRACE_LIGHTWEIGHT_VLM_WORKER_TIMEOUT_SECONDS=60
# Stable default keeps one analysis job active at a time. Experimental/dev
# machines can raise analysis concurrency after validating memory headroom.
SAFETRACE_WORKER_CONCURRENCY=1
SAFETRACE_ANALYSIS_CONCURRENCY=1
SAFETRACE_ADAPTIVE_WORKERS_ENABLED=0
SAFETRACE_WORKER_MIN=2
SAFETRACE_WORKER_MAX=3
# Keep false until scripts/smoke_adaptive_worker_scaling.py passes with real models.
SAFETRACE_THIRD_WORKER_VALIDATED=0
SAFETRACE_SCALE_UP_QUEUE_DEPTH=3
SAFETRACE_SCALE_UP_SUSTAIN_SECONDS=15
SAFETRACE_SCALE_DOWN_IDLE_SECONDS=60
SAFETRACE_SCALE_COOLDOWN_SECONDS=60
SAFETRACE_GPU_FREE_MEMORY_MARGIN_MB=4096
SAFETRACE_SYSTEM_FREE_MEMORY_MARGIN_MB=4096
SAFETRACE_VLM_CONCURRENCY=1
SAFETRACE_MID_VLM_ENABLED=0
SAFETRACE_MID_VLM_MODEL_PATH=models/vlm/lightweight-512m
SAFETRACE_MID_VLM_DEVICE=cuda
SAFETRACE_MID_VLM_CONCURRENCY=1
SAFETRACE_MID_VLM_MAX_FRAMES=2
SAFETRACE_MID_VLM_TIMEOUT_SECONDS=90
SAFETRACE_DIAGNOSTIC_FRAMES_ENABLED=0
# Phase N overnight batch controls. Increase only after representative hardware validation.
SAFETRACE_BATCH_MAX_ACTIVE_JOBS=2
SAFETRACE_MAX_QUEUED_JOBS=250
SAFETRACE_MIN_FREE_DISK_MB=2048
SAFETRACE_MIN_AVAILABLE_MEMORY_MB=1024
SAFETRACE_JOB_RETRY_MAX_ATTEMPTS=2
SAFETRACE_JOB_RETRY_BACKOFF_SECONDS=5
SAFETRACE_RECOVERY_POLICY=prompt
SAFETRACE_COMPLETED_RETENTION_DAYS=30
SAFETRACE_FAILED_RETENTION_DAYS=7
SAFETRACE_RECOVERY_RETENTION_HOURS=72
SAFETRACE_CACHE_RETENTION_DAYS=14
SAFETRACE_CACHE_MAX_GB=5
SAFETRACE_LOG_RETENTION_DAYS=14
SAFETRACE_MIN_FREE_DISK_GB=2
SAFETRACE_RETENTION_SCHEDULER_ENABLED=true
SAFETRACE_RETENTION_INTERVAL_MINUTES=60
SAFETRACE_RETENTION_STARTUP_DELAY_SECONDS=30
SAFETRACE_BULK_MAX_COMPRESSION_RATIO=100
# Comprehensive Review screens more frames while expensive refinement remains capped.
SAFETRACE_COMPREHENSIVE_REVIEW_FPS=2
SAFETRACE_COMPREHENSIVE_REVIEW_MAX_FRAMES=1200
SAFETRACE_COMPREHENSIVE_REVIEW_TOP_K=12
SAFETRACE_COMPREHENSIVE_MAX_SEGMENTATION_FRAMES=8
SAFETRACE_COMPREHENSIVE_MAX_VLM_FRAMES=5
# Comma-separated live frontend origins, for example:
# SAFETRACE_ALLOWED_ORIGINS=https://your-site.pages.dev,https://your-site.netlify.app
SAFETRACE_ALLOWED_ORIGINS=https://safetrace-iota.vercel.app,http://127.0.0.1:5173,http://localhost:5173
# Central development-only work root for pytest, smoke, build, and Codex artifacts.
# Production runtime does not depend on this directory.
SAFETRACE_DEV_WORK_ROOT=.ai-pipeline/006_work
