# SafeTrace source-only Fast Local profile. Copy to config/safetrace.env.
# This profile does not require CUDA, VLM model weights, or the chatbot GGUF.
SAFETRACE_PROJECT_ROOT=.
SAFETRACE_DATA_DIR=data
SAFETRACE_CHECKPOINTS_DIR=checkpoints
SAFETRACE_SIGLIP_DIR=checkpoints/siglip-base-patch16-224
SAFETRACE_YOLO_CKPT=checkpoints/yolov9c-seg.pt
SAFETRACE_YOLO_FALLBACK_CKPT=checkpoints/yolov8s-seg.pt
SAFETRACE_DEVICE=auto
SAFETRACE_ENABLE_GPU_AUTO=true
SAFETRACE_ANALYSIS_SAFE_MODE=true
SAFETRACE_ANALYSIS_CONCURRENCY=1
SAFETRACE_WORKER_CONCURRENCY=1
SAFETRACE_VLM_ENABLED=0
SAFETRACE_ENABLE_VLM=0
SAFETRACE_LIGHTWEIGHT_VLM_ENABLED=0
SAFETRACE_ENHANCED_VLM_ENABLED=0
SAFETRACE_LIGHTWEIGHT_VLM_WORKER_ENABLED=0
SAFETRACE_VLM_PROFILE=rule_based
SAFETRACE_CHAT_ENABLED=0
SAFETRACE_MOBILESAM_ENABLED=0
SAFETRACE_MOBILESAM_WORKER_ENABLED=0
SAFETRACE_MOBILESAM_CHECKPOINT=checkpoints/mobile_sam.pt
SAFETRACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFETRACE_INCLUDE_LOCAL_CORS_ORIGINS=true
SAFETRACE_SERVE_FRONTEND=false
SAFETRACE_BUILD_MODE=source-fastlocal
SAFETRACE_RUNTIME_LAYOUT=source
