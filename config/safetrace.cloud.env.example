# SafeTrace_Cloud_FastLocal - copy to a platform-managed environment, never commit real values.
SAFETRACE_BUILD_MODE=SafeTrace_Cloud_FastLocal
SAFETRACE_RUNTIME_LAYOUT=cloud-container
SAFETRACE_PROJECT_ROOT=/app
SAFETRACE_DATA_DIR=/var/lib/safetrace/data
SAFETRACE_CHECKPOINTS_DIR=/app/checkpoints
SAFETRACE_SIGLIP_DIR=/app/checkpoints/siglip-base-patch16-224
SAFETRACE_YOLO_CKPT=/app/checkpoints/yolov9c-seg.pt
SAFETRACE_YOLO_FALLBACK_CKPT=/app/checkpoints/yolov8s-seg.pt
SAFETRACE_DEVICE=auto
SAFETRACE_ANALYSIS_SAFE_MODE=true
SAFETRACE_ANALYSIS_CONCURRENCY=1
SAFETRACE_WORKER_CONCURRENCY=1
SAFETRACE_VLM_ENABLED=0
SAFETRACE_ENABLE_VLM=0
SAFETRACE_LIGHTWEIGHT_VLM_ENABLED=0
SAFETRACE_ENHANCED_VLM_ENABLED=0
SAFETRACE_LIGHTWEIGHT_VLM_WORKER_ENABLED=0
SAFETRACE_VLM_PROFILE=rule_based
SAFETRACE_CHAT_ENABLED=0
SAFETRACE_MOBILESAM_ENABLED=0
SAFETRACE_MOBILESAM_WORKER_ENABLED=0
SAFETRACE_MOBILESAM_CHECKPOINT=/app/checkpoints/mobile_sam.pt
SAFETRACE_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
SAFETRACE_INCLUDE_LOCAL_CORS_ORIGINS=false
PORT=8000
